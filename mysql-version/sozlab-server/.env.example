# ── SözLab server ayarları ─────────────────────────────────────────────
# Bu faylın adını ".env" edin VƏ YA eyni dəyərləri cPanel → Setup Node.js App →
# "Environment variables" bölməsinə yazın (panel dəyəri üstündür).

# MySQL (cPanel → MySQL Database Wizard-da yaratdığınız məlumatlar)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneladi_sozlab
DB_USER=cpaneladi_sozuser
DB_PASSWORD=buraya_guclu_sifre

# E-poçt təsdiqi: off → şagird qeydiyyatdan keçən kimi daxil olur (tövsiyə)
#                 on  → 6 rəqəmli kod e-poçtla gedir (aşağıdakı SMTP lazımdır)
EMAIL_CONFIRM=off
SMTP_HOST=mail.saytiniz.az
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@saytiniz.az
SMTP_PASS=
SMTP_FROM=noreply@saytiniz.az

# Şəkil yükləmə limiti (MB) və sessiya müddəti (gün)
MAX_UPLOAD_MB=8
SESSION_DAYS=30
